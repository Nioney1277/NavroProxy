+++ b/src/network/mcpe/auth/ProxyBackendIdentityVerifier.php
@@ -0,0 +1,135 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\network\mcpe\auth;
+
+use pocketmine\network\PacketHandlingException;
+use function array_filter;
+use function array_is_list;
+use function base64_decode;
+use function count;
+use function explode;
+use function is_array;
+use function is_int;
+use function is_string;
+use function hash_equals;
+use function in_array;
+use function json_decode;
+use function preg_match;
+use function openssl_pkey_get_details;
+use function openssl_pkey_get_public;
+use function openssl_verify;
+use function strlen;
+use function str_repeat;
+use function strtr;
+use function time;
+
+/** Verifies the proxy assertion embedded in a private RakNet login token. */
+final class ProxyBackendIdentityVerifier{
+	private const ISSUER = "navro-proxy";
+	private const AUDIENCE = "urn:navro:raknet-backend";
+	private const MAX_TOKEN_SIZE = 16_384;
+	private const MAX_USED_JTIS = 8_192;
+
+	/** @var array<string, int> */
+	private array $usedJtis = [];
+	private \OpenSSLAsymmetricKey $key;
+
+	public function __construct(string $publicKeyPem){
+		$key = openssl_pkey_get_public($publicKeyPem);
+		if($key === false){
+			throw new \InvalidArgumentException("Could not parse proxy RSA public key");
+		}
+		$details = openssl_pkey_get_details($key);
+		if($details === false || $details["type"] !== OPENSSL_KEYTYPE_RSA || $details["bits"] < 2048){
+			throw new \InvalidArgumentException("Proxy RSA public key must be at least 2048 bits");
+		}
+		$this->key = $key;
+	}
+
+	/** @param array<string, mixed> $loginClaims */
+	public function verify(array $loginClaims) : string{
+		$token = $loginClaims["proxyAuth"] ?? null;
+		if(!is_string($token) || $token === "" || strlen($token) > self::MAX_TOKEN_SIZE){
+			throw new PacketHandlingException("Missing or oversized proxy identity assertion");
+		}
+		$parts = explode(".", $token);
+		if(count($parts) !== 3){
+			throw new PacketHandlingException("Malformed proxy identity assertion");
+		}
+		$header = $this->decodeObject($parts[0], "proxy identity header");
+		$claims = $this->decodeObject($parts[1], "proxy identity claims");
+		$signature = self::decodeBase64Url($parts[2]);
+		if(($header["alg"] ?? null) !== "RS256" || ($header["kid"] ?? null) !== self::ISSUER || $signature === null){
+			throw new PacketHandlingException("Unsupported proxy identity signature");
+		}
+		$verified = openssl_verify($parts[0] . "." . $parts[1], $signature, $this->key, OPENSSL_ALGO_SHA256);
+		if($verified !== 1){
+			throw new PacketHandlingException("Invalid proxy identity signature");
+		}
+
+		$now = time();
+		$audience = $claims["aud"] ?? null;
+		$audienceMatches = $audience === self::AUDIENCE || (is_array($audience) && in_array(self::AUDIENCE, $audience, true));
+		$issuedAt = $claims["iat"] ?? null;
+		$expires = $claims["exp"] ?? null;
+		$jti = $claims["jti"] ?? null;
+		if(($claims["iss"] ?? null) !== self::ISSUER || ($claims["sub"] ?? null) !== self::ISSUER ||
+			!$audienceMatches || !is_int($issuedAt) || !is_int($expires) ||
+			$issuedAt > $now + 5 || $expires <= $now || $expires <= $issuedAt || $expires - $issuedAt > 120 ||
+			!is_string($jti) || !preg_match('/^[0-9a-f-]{36}$/i', $jti)){
+			throw new PacketHandlingException("Expired or invalid proxy identity claims");
+		}
+		foreach(["cpk", "leguuid", "xname"] as $field){
+			if(!is_string($loginClaims[$field] ?? null) || !is_string($claims[$field] ?? null) ||
+				!hash_equals($loginClaims[$field], $claims[$field])){
+				throw new PacketHandlingException("Proxy assertion does not match forwarded login " . $field);
+			}
+		}
+		if(isset($claims["xid"]) && (!is_string($claims["xid"]) || !preg_match('/^[0-9]{0,20}$/', $claims["xid"]))){
+			throw new PacketHandlingException("Invalid forwarded XUID");
+		}
+		if(isset($loginClaims["xid"]) && (!is_string($loginClaims["xid"]) || !hash_equals($loginClaims["xid"], $claims["xid"] ?? ""))){
+			throw new PacketHandlingException("Proxy assertion does not match forwarded login xid");
+		}
+		$this->pruneJtis($now);
+		if(isset($this->usedJtis[$jti]) || count($this->usedJtis) >= self::MAX_USED_JTIS){
+			throw new PacketHandlingException("Replayed or over-capacity proxy identity assertion");
+		}
+		$this->usedJtis[$jti] = $expires;
+		return $claims["xid"] ?? "";
+	}
+
+	/** @return array<string, mixed> */
+	private function decodeObject(string $part, string $context) : array{
+		$decoded = self::decodeBase64Url($part);
+		if($decoded === null){
+			throw new PacketHandlingException("Invalid " . $context);
+		}
+		try{
+			$value = json_decode($decoded, true, flags: JSON_THROW_ON_ERROR);
+		}catch(\JsonException $e){
+			throw PacketHandlingException::wrap($e, "Invalid " . $context);
+		}
+		if(!is_array($value) || array_is_list($value)){
+			throw new PacketHandlingException("Unexpected " . $context . " type");
+		}
+		return $value;
+	}
+
+	private static function decodeBase64Url(string $value) : ?string{
+		$normalized = strtr($value, "-_", "+/");
+		$normalized .= str_repeat("=", (4 - strlen($normalized) % 4) % 4);
+		$decoded = base64_decode($normalized, true);
+		return $decoded === false ? null : $decoded;
+	}
+
+	private function pruneJtis(int $now) : void{
+		foreach($this->usedJtis as $jti => $expires){
+			if($expires <= $now){
+				unset($this->usedJtis[$jti]);
+			}
+		}
+	}
+}
