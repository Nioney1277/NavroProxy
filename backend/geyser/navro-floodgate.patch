+    private static boolean encryptNavroConnection(GeyserSession session, NavroForwardedLogin forwarding,
+                                                  AuthPayload payload, String jwt) {
+        var config = session.getGeyser().config();
+        var upstream = session.getUpstream().getSession();
+        if (!"127.0.0.1".equals(config.bedrock().address())
+                || !config.advanced().bedrock().validateBedrockLogin()
+                || config.advanced().bedrock().useWaterdogpeForwarding()
+                || !config.advanced().bedrock().haproxyProtocolWhitelistedIps().isEmpty()
+                || config.java().authType() != org.geysermc.geyser.api.network.AuthType.FLOODGATE
+                || upstream.getPeer() instanceof NetherNetPeer) {
+            session.disconnect("Navro forwarding requires private RakNet with Floodgate and Xbox validation enabled");
+            return false;
+        }
+
+        try {
+            var identity = forwarding.verify(payload, upstream.getSocketAddress());
+            byte[] clientData = EncryptionUtils.verifyClientData(jwt, identity.sessionKey());
+            if (clientData == null) {
+                throw new IllegalArgumentException("Invalid forwarded client data signature");
+            }
+            BedrockClientData data = JsonUtils.fromJson(clientData, BedrockClientData.class);
+            session.setClientData(data);
+            session.getUpstream().setInetAddress(identity.address());
+            session.setAuthData(new AuthData(identity.username(), identity.uuid(), identity.xuid(),
+                    identity.issuedAt(), identity.minecraftId()));
+            CodecProcessor.updateCodec(session.getUpstream(), data.getGameVersion());
+            return startEncryptionHandshake(session, identity.sessionKey());
+        } catch (Exception ex) {
+            session.disconnect("Invalid Navro forwarded login");
+            return false;
+        }
+    }
